{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PositionBar release plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "source_sha",
    "changes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "items"
        ],
        "properties": {
          "type": {
            "enum": [
              "new",
              "improved",
              "fixed"
            ]
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh-Hans",
              "zh-Hant",
              "ko",
              "ru",
              "pt-BR",
              "tr",
              "ja"
            ],
            "properties": {
              "en": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                }
              },
              "zh-Hans": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                }
              },
              "zh-Hant": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                }
              },
              "ko": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                }
              },
              "ru": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                }
              },
              "pt-BR": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                }
              },
              "tr": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                }
              },
              "ja": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?=.*\\S)[^\\r\\n]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
